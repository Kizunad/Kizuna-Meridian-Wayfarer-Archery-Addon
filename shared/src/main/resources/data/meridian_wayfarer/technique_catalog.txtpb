# 行矢正式目录。数值均为占位；work 在每次准备拉弦的开始事件支付。

schema_version: 1

namespace: "meridian_wayfarer"

binding_templates { id: "human:adult" version: 1 }

books {
  id: "meridian_wayfarer:wayfarer"
  display_name: "行矢"
  held_item_rules {

    categories {
      id: "bows"
      item_tags: "meridian_wayfarer:bows"
      projectile_weapon: BOW
      ammunition_tags: "meridian_wayfarer:ammo"
      selection_priority: 0
      base_damage_source: FIXED_DAMAGE
      base_damage { value: 2.5 unit: DAMAGE_POINT }
      injury_kind: BLUNT
      shield_interaction: NO_SHIELD_BREAK
      can_break_doors: false
    }

    categories {
      id: "crossbows"
      item_tags: "meridian_wayfarer:crossbows"
      projectile_weapon: CROSSBOW
      ammunition_tags: "meridian_wayfarer:crossbow_ammo"
      selection_priority: 0
      base_damage_source: FIXED_DAMAGE
      base_damage { value: 2.5 unit: DAMAGE_POINT }
      injury_kind: BLUNT
      shield_interaction: NO_SHIELD_BREAK
      can_break_doors: false
    }

    categories {
      id: "other_items"
      selection_priority: 1
      base_damage_source: FIXED_DAMAGE
      base_damage { value: 2.5 unit: DAMAGE_POINT }
      injury_kind: BLUNT
      shield_interaction: NO_SHIELD_BREAK
      can_break_doors: false
    }

    durability { multiplier { value: 1 unit: RATIO } }
    selection_order: CATEGORY_PRIORITY
    selection_order: DURABILITY_MULTIPLIER
    selection_order: PREFER_MAIN_HAND
    ammunition_tags: "meridian_wayfarer:ammo"
    require_ammunition: true
    other_hand_empty_or_ammunition: true
  }
}

volumes {
  id: "meridian_wayfarer:bow_upper"
  book_id: "meridian_wayfarer:wayfarer"
  display_name: "百步"
  techniques { id: "meridian_wayfarer:full_draw" version: 1 }
  techniques { id: "meridian_wayfarer:pearls" version: 1 }
  techniques { id: "meridian_wayfarer:bow_strike" version: 1 }
  techniques { id: "meridian_wayfarer:dry_draw" version: 1 }
}

volumes {
  id: "meridian_wayfarer:crossbow"
  book_id: "meridian_wayfarer:wayfarer"
  display_name: "机弩"
  techniques { id: "meridian_wayfarer:repeater" version: 1 }
  techniques { id: "meridian_wayfarer:gale" version: 1 }
  techniques { id: "meridian_wayfarer:kneeling" version: 1 }
}

volumes {
  id: "meridian_wayfarer:bow_lower"
  book_id: "meridian_wayfarer:wayfarer"
  display_name: "万矢"
  techniques { id: "meridian_wayfarer:parthian" version: 1 }
  techniques { id: "meridian_wayfarer:arrow_rain" version: 1 }
  techniques { id: "meridian_wayfarer:convergence" version: 1 }
  prerequisite_volume_ids: "meridian_wayfarer:bow_upper"
}

definitions {
  id: "meridian_wayfarer:full_draw"
  version: 1
  category: ATTACK
  minimum_realm: WANDERING_QI
  projectile_weapon: BOW
  require_ammunition: true
  movement_speed_multiplier: 0.4
  slots {
    id: "hand_meridians"
    module: MERIDIAN
    tags: "human:hand_meridian"
    minimum_count: 1
    maximum_count: 6
    require_opened: true
  }
  slots {
    id: "arms"
    module: TISSUE
    tags: "human:arm_muscle"
    minimum_count: 6
    maximum_count: 6
  }
  cost {
    qi {
      slot_id: "hand_meridians"
      matching: ANY_ATTRIBUTE_AT_LEAST_PHASE
      phase: FREE
      amount { value: 8 unit: QI }
      distribution: EVEN
    }
  }
  phases {
    warmup_millis: 3600
    active_millis: 0
    recovery_millis: 2400
    interruptible_by_damage: true
  }
  cooldown_millis: 4000
  effects {
    at_millis: 0
    presentation {
      id: "meridian_wayfarer:wayfarer_full_draw"
      duration: UNTIL_RECOVERY_END
      start_millis: 0
    }
  }
  effects {
    at_millis: 2300
    work {
      slot_id: "arms"
      force { value: 0 unit: NEWTON }
      power { value: 41.666666666666664 unit: WATT }
      duration { value: 1.3 unit: SECOND }
    }
  }
  effects {
    at_millis: 3600
    launch_projectile {
      projectile_weapon: BOW
      speed_multiplier { value: 1.3 unit: RATIO }
      damage_multiplier { value: 1.5 unit: RATIO }
      critical: true
      piercing: 1
      spread { value: 0 unit: DEGREE }
      look: true
      multiply_draw_strength: true
      draw_strength_arm: OTHER_ARM
      shield_cooldown_millis: 0
      mirror_by_hand: false
    }
  }
  follow_up {
    transitions {
      previous { id: "meridian_wayfarer:repeater" version: 1 }
      recovery_start_ratio { value: 0.5 unit: RATIO }
      after_recovery_millis: 500
      start_millis: 400
      previous_projectile_weapon: CROSSBOW
      next_projectile_weapon: BOW
    }
    transitions {
      previous { id: "meridian_wayfarer:gale" version: 1 }
      recovery_start_ratio { value: 0.5 unit: RATIO }
      after_recovery_millis: 500
      start_millis: 400
      previous_projectile_weapon: CROSSBOW
      next_projectile_weapon: BOW
    }
    transitions {
      previous { id: "meridian_wayfarer:kneeling" version: 1 }
      recovery_start_ratio { value: 0.5 unit: RATIO }
      after_recovery_millis: 500
      start_millis: 400
      previous_projectile_weapon: CROSSBOW
      next_projectile_weapon: BOW
    }
  }
  ai_hints {
    minimum_distance { value: 15 unit: METER }
    maximum_distance { value: 32 unit: METER }
    maximum_hp_ratio { value: 1 unit: RATIO }
    minimum_qi_ratio { value: 0 unit: RATIO }
    category_weight { value: 1 unit: RATIO }
  }
  presentation {
    icon_id: "meridian_wayfarer:full_draw"
    display_name: "满月"
    description: "满月"
  }
}

